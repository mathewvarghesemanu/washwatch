<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WashWatch" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!-- Brief system splash; it hands off to the in-app intro as soon as the first frame is drawn. -->
    <style name="Theme.WashWatch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/washwatch_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WashWatch</item>
    </style>
</resources>
